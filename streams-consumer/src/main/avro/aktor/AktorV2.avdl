// Kopi av navikt/pdl libs/contract-pdl-avro/src/main/avro/no/nav/person/pdl/aktor/AktorV2.avdl
@namespace("no.nav.person.pdl.aktor.v2")
protocol AktorProtoV2 {

  enum Type {
    FOLKEREGISTERIDENT,
    AKTORID,
    NPID
  }

  record Identifikator {
    string idnummer;
    Type type;
    boolean gjeldende;
  }

  record Aktor {
    array<Identifikator> identifikatorer;
  }
}
